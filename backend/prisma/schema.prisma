// DevDarshanMarg - PostgreSQL Database Schema
// India's Temple, Pilgrimage & Spiritual Knowledge Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Supported languages: Gujarati, Hindi, English
enum Language {
  gu
  hi
  en
}

enum UserRole {
  ADMIN
  USER
}

enum UserEntityType {
  TEMPLE
  FESTIVAL
  DEITY
  CONTENT
}

enum MediaType {
  image
  video
  document
}

enum ContentStatus {
  draft
  published
  archived
}

enum Status {
  ACTIVE
  INACTIVE
  ARCHIVED
}

// ─── Module 1 Part 1: Geographic & Language Reference ─────────────────

model Continent {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(150)
  officialName String?   @map("official_name") @db.VarChar(200)
  slug         String    @unique @db.VarChar(255)
  code         String?   @unique @db.VarChar(10)
  description  String?   @db.Text
  icon         String?   @db.VarChar(255)
  image        String?   @db.VarChar(500)
  sortOrder    Int       @default(0) @map("sort_order")
  status       Status    @default(ACTIVE)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  countries Country[]

  @@index([name])
  @@map("continents")
}

model Country {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(150)
  officialName   String?   @map("official_name") @db.VarChar(200)
  displayName    String?   @map("display_name") @db.VarChar(200)
  slug           String    @unique @db.VarChar(255)
  iso2           String    @unique @db.Char(2)
  iso3           String    @unique @db.Char(3)
  phoneCode      String?   @map("phone_code") @db.VarChar(10)
  currencyCode   String?   @map("currency_code") @db.VarChar(10)
  currencyName   String?   @map("currency_name") @db.VarChar(50)
  currencySymbol String?   @map("currency_symbol") @db.VarChar(10)
  capital        String?   @db.VarChar(120)
  continentId    String?   @map("continent_id") @db.Uuid
  timezone       String?   @db.VarChar(120)
  flagImage      String?   @map("flag_image") @db.Text
  emojiFlag      String?   @map("emoji_flag") @db.VarChar(20)
  tld            String?   @db.VarChar(20)
  latitude       Decimal?  @db.Decimal(10, 8)
  longitude      Decimal?  @db.Decimal(11, 8)
  population     BigInt?
  areaSqKm       Decimal?  @map("area_sq_km") @db.Decimal(12, 2)
  isDefault      Boolean   @default(false) @map("is_default")
  sortOrder      Int       @default(0) @map("sort_order")
  status         Status    @default(ACTIVE)
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  continent       Continent?       @relation(fields: [continentId], references: [id], onDelete: SetNull)
  states          State[]
  cities          City[]
  areas           Area[]
  temples         Temple[]
  festivalRegions FestivalRegion[]
  panchangs       Panchang[]
  panchangRegions PanchangRegion[]

  @@index([name])
  @@index([continentId])
  @@map("countries")
}

model State {
  id           String    @id @default(uuid()) @db.Uuid
  countryId    String    @map("country_id") @db.Uuid
  name         String    @db.VarChar(150)
  officialName String?   @map("official_name") @db.VarChar(200)
  slug         String    @db.VarChar(255)
  code         String?   @db.VarChar(20)
  capital      String?   @db.VarChar(120)
  gstCode      String?   @map("gst_code") @db.VarChar(10)
  latitude     Decimal?  @db.Decimal(10, 8)
  longitude    Decimal?  @db.Decimal(11, 8)
  population   BigInt?
  areaSqKm     Decimal?  @map("area_sq_km") @db.Decimal(12, 2)
  description  String?   @db.Text
  sortOrder    Int       @default(0) @map("sort_order")
  status       Status    @default(ACTIVE)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  country         Country          @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities          City[]
  areas           Area[]
  temples         Temple[]
  festivalRegions FestivalRegion[]
  panchangs       Panchang[]
  panchangRegions PanchangRegion[]

  @@unique([countryId, slug])
  @@index([countryId])
  @@index([name])
  @@map("states")
}

model City {
  id           String    @id @default(uuid()) @db.Uuid
  countryId    String    @map("country_id") @db.Uuid
  stateId      String    @map("state_id") @db.Uuid
  name         String?   @db.VarChar(150)
  officialName String?   @map("official_name") @db.VarChar(200)
  slug         String    @db.VarChar(255)
  cityType     String?   @map("city_type") @db.VarChar(50)
  latitude     Decimal?  @db.Decimal(10, 8)
  longitude    Decimal?  @db.Decimal(11, 8)
  elevation    Decimal?  @db.Decimal(8, 2)
  timezone     String?   @db.VarChar(120)
  population   BigInt?
  isCapital    Boolean   @default(false) @map("is_capital")
  isMetro      Boolean   @default(false) @map("is_metro")
  description  String?   @db.Text
  sortOrder    Int       @default(0) @map("sort_order")
  status       Status    @default(ACTIVE)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  country         Country          @relation(fields: [countryId], references: [id], onDelete: Cascade)
  state           State            @relation(fields: [stateId], references: [id], onDelete: Cascade)
  areas           Area[]
  temples         Temple[]
  festivalRegions FestivalRegion[]
  panchangRegions PanchangRegion[]

  @@unique([stateId, slug])
  @@index([countryId])
  @@index([stateId])
  @@map("cities")
}

model Area {
  id           String    @id @default(uuid()) @db.Uuid
  countryId    String    @map("country_id") @db.Uuid
  stateId      String    @map("state_id") @db.Uuid
  cityId       String    @map("city_id") @db.Uuid
  name         String?   @db.VarChar(150)
  slug         String    @db.VarChar(255)
  areaType     String?   @map("area_type") @db.VarChar(50)
  addressLine1 String?   @map("address_line1") @db.VarChar(255)
  addressLine2 String?   @map("address_line2") @db.VarChar(255)
  postalCode   String?   @map("postal_code") @db.VarChar(20)
  landmark     String?   @db.VarChar(255)
  latitude     Decimal?  @db.Decimal(10, 8)
  longitude    Decimal?  @db.Decimal(11, 8)
  description  String?   @db.Text
  sortOrder    Int       @default(0) @map("sort_order")
  status       Status    @default(ACTIVE)
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  country Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  state   State    @relation(fields: [stateId], references: [id], onDelete: Cascade)
  city    City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  temples Temple[]

  @@unique([cityId, slug])
  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
  @@map("areas")
}

/// Supported platform languages (table: languages)
model SupportedLanguage {
  id         String    @id @default(uuid()) @db.Uuid
  name       String?   @db.VarChar(100)
  nativeName String?   @map("native_name") @db.VarChar(100)
  isoCode    String?   @unique @map("iso_code") @db.VarChar(10)
  locale     String?   @unique @db.VarChar(20)
  direction  String?   @db.VarChar(10)
  fontFamily String?   @map("font_family") @db.VarChar(100)
  flagImage  String?   @map("flag_image") @db.Text
  isDefault  Boolean   @default(false) @map("is_default")
  isRtl      Boolean   @default(false) @map("is_rtl")
  sortOrder  Int       @default(0) @map("sort_order")
  status     Status    @default(ACTIVE)
  createdBy  String?   @map("created_by") @db.Uuid
  updatedBy  String?   @map("updated_by") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  aartis                  TempleAarti[]
  poojas                  TemplePooja[]
  faqs                    TempleFaq[]
  templeMedia             TempleMedia[]
  templeDocuments         TempleDocument[]
  templeSources           TempleSource[]
  festivalKathas          FestivalKatha[]
  festivalMantras         FestivalMantra[]
  festivalAartis          FestivalAarti[]
  festivalBhajans         FestivalBhajan[]
  festivalGalleries       FestivalGallery[]
  festivalVideos          FestivalVideo[]
  contentItemTranslations ContentItemTranslation[]
  contentMedia            ContentMedia[]
  contentAttachments      ContentAttachment[]
  panchangSources         PanchangSource[]

  @@index([name])
  @@map("languages")
}

// ─── Module 1 Part 2: Spiritual & Platform Reference ──────────────────

model DeityType {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(150)
  displayName    String?   @map("display_name") @db.VarChar(200)
  slug           String    @unique @db.VarChar(255)
  description    String?   @db.Text
  icon           String?   @db.VarChar(255)
  image          String?   @db.VarChar(500)
  color          String?   @db.VarChar(20)
  alternateNames String?   @map("alternate_names") @db.Text
  searchKeywords String?   @map("search_keywords") @db.Text
  seoTitle       String?   @map("seo_title") @db.VarChar(255)
  seoDescription String?   @map("seo_description") @db.Text
  status         Status    @default(ACTIVE)
  sortOrder      Int       @default(0) @map("sort_order")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  deities Deity[]

  @@index([name])
  @@map("deity_types")
}

model Deity {
  id             String    @id @default(uuid()) @db.Uuid
  deityTypeId    String    @map("deity_type_id") @db.Uuid
  name           String?   @db.VarChar(150)
  displayName    String?   @map("display_name") @db.VarChar(200)
  slug           String    @unique @db.VarChar(255)
  shortName      String?   @map("short_name") @db.VarChar(100)
  description    String?   @db.Text
  icon           String?   @db.VarChar(255)
  image          String?   @db.VarChar(500)
  primaryMantra  String?   @map("primary_mantra") @db.Text
  symbol         String?   @db.VarChar(255)
  vehicle        String?   @db.VarChar(150)
  weapon         String?   @db.VarChar(150)
  consort        String?   @db.VarChar(150)
  alternateNames String?   @map("alternate_names") @db.Text
  searchKeywords String?   @map("search_keywords") @db.Text
  isPopular      Boolean   @default(false) @map("is_popular")
  isFeatured     Boolean   @default(false) @map("is_featured")
  seoTitle       String?   @map("seo_title") @db.VarChar(255)
  seoDescription String?   @map("seo_description") @db.Text
  status         Status    @default(ACTIVE)
  sortOrder      Int       @default(0) @map("sort_order")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  deityType         DeityType            @relation(fields: [deityTypeId], references: [id], onDelete: Cascade)
  templeDeityMaps   TempleDeityMap[]
  festivalDeityMaps FestivalDeityMap[]
  profile           DeityProfile?
  avatars           DeityAvatar[]
  relations         DeityRelation[]      @relation("DeityRelationFrom")
  relatedFrom       DeityRelation[]      @relation("DeityRelationTo")
  symbols           DeitySymbol[]
  attributes        DeityAttribute[]
  blessings         DeityBlessing[]
  associations      DeityAssociation[]
  statistics        DeityStatistics?
  externalLinks     DeityExternalLink[]
  changeHistory     DeityChangeHistory[]

  @@index([deityTypeId])
  @@index([name])
  @@map("deities")
}

model TempleCategory {
  id             String    @id @default(uuid()) @db.Uuid
  name           String?   @db.VarChar(150)
  displayName    String?   @map("display_name") @db.VarChar(200)
  slug           String    @unique @db.VarChar(255)
  description    String?   @db.Text
  icon           String?   @db.VarChar(255)
  image          String?   @db.VarChar(500)
  alternateNames String?   @map("alternate_names") @db.Text
  searchKeywords String?   @map("search_keywords") @db.Text
  seoTitle       String?   @map("seo_title") @db.VarChar(255)
  seoDescription String?   @map("seo_description") @db.Text
  isFeatured     Boolean   @default(false) @map("is_featured")
  status         Status    @default(ACTIVE)
  sortOrder      Int       @default(0) @map("sort_order")
  createdBy      String?   @map("created_by") @db.Uuid
  updatedBy      String?   @map("updated_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  temples TempleCategoryMap[]

  @@index([name])
  @@map("temple_categories")
}

/// Platform media type definitions (table: media_types)
model SupportedMediaType {
  id                String    @id @default(uuid()) @db.Uuid
  name              String?   @db.VarChar(100)
  slug              String    @unique @db.VarChar(100)
  description       String?   @db.Text
  icon              String?   @db.VarChar(255)
  mimeType          String?   @map("mime_type") @db.VarChar(150)
  allowedExtensions String?   @map("allowed_extensions") @db.Text
  maxFileSize       BigInt?   @map("max_file_size")
  status            Status    @default(ACTIVE)
  sortOrder         Int       @default(0) @map("sort_order")
  createdBy         String?   @map("created_by") @db.Uuid
  updatedBy         String?   @map("updated_by") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  templeMedia       TempleMedia[]
  festivalGalleries FestivalGallery[]
  festivalVideos    FestivalVideo[]
  contentMedia      ContentMedia[]

  @@index([name])
  @@map("media_types")
}

/// Platform content status definitions (table: content_statuses)
model SupportedContentStatus {
  id          String    @id @default(uuid()) @db.Uuid
  name        String?   @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  color       String?   @db.VarChar(20)
  status      Status    @default(ACTIVE)
  sortOrder   Int       @default(0) @map("sort_order")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  @@index([name])
  @@map("content_statuses")
}

// ─── Module 2 Part 1: Temple Core ─────────────────────────────────────

model Temple {
  id                     String    @id @default(uuid()) @db.Uuid
  countryId              String    @map("country_id") @db.Uuid
  stateId                String    @map("state_id") @db.Uuid
  cityId                 String    @map("city_id") @db.Uuid
  areaId                 String    @map("area_id") @db.Uuid
  name                   String?   @db.VarChar(200)
  displayName            String?   @map("display_name") @db.VarChar(255)
  canonicalName          String?   @map("canonical_name") @db.VarChar(255)
  slug                   String    @unique @db.VarChar(255)
  shortName              String?   @map("short_name") @db.VarChar(120)
  shortDescription       String?   @map("short_description") @db.Text
  description            String?   @db.Text
  history                String?   @db.Text
  significance           String?   @db.Text
  architecture           String?   @db.Text
  alternateNames         String?   @map("alternate_names") @db.Text
  famousFor              String?   @map("famous_for") @db.Text
  templeCode             String?   @unique @map("temple_code") @db.VarChar(50)
  foundedYear            Int?      @map("founded_year")
  establishedDate        DateTime? @map("established_date") @db.Date
  lastRenovatedDate      DateTime? @map("last_renovated_date") @db.Date
  openingYear            Int?      @map("opening_year")
  closingRemarks         String?   @map("closing_remarks") @db.Text
  latitude               Decimal?  @db.Decimal(10, 8)
  longitude              Decimal?  @db.Decimal(11, 8)
  googleMapUrl           String?   @map("google_map_url") @db.Text
  virtualTourUrl         String?   @map("virtual_tour_url") @db.Text
  youtubeVideoUrl        String?   @map("youtube_video_url") @db.Text
  officialWebsite        String?   @map("official_website") @db.Text
  instagramUrl           String?   @map("instagram_url") @db.VarChar(255)
  facebookUrl            String?   @map("facebook_url") @db.VarChar(255)
  twitterUrl             String?   @map("twitter_url") @db.VarChar(255)
  phone                  String?   @db.VarChar(30)
  email                  String?   @db.VarChar(150)
  addressLine1           String?   @map("address_line1") @db.VarChar(255)
  addressLine2           String?   @map("address_line2") @db.VarChar(255)
  postalCode             String?   @map("postal_code") @db.VarChar(20)
  landmark               String?   @db.VarChar(255)
  dressCode              String?   @map("dress_code") @db.Text
  bestTimeToVisit        String?   @map("best_time_to_visit") @db.Text
  estimatedVisitTime     Int?      @map("estimated_visit_time")
  entryFee               Decimal?  @map("entry_fee") @db.Decimal(10, 2)
  parkingAvailable       Boolean   @default(false) @map("parking_available")
  wheelchairAccessible   Boolean   @default(false) @map("wheelchair_accessible")
  photographyAllowed     Boolean   @default(false) @map("photography_allowed")
  mobileAllowed          Boolean   @default(true) @map("mobile_allowed")
  prasadamAvailable      Boolean   @default(false) @map("prasadam_available")
  accommodationAvailable Boolean   @default(false) @map("accommodation_available")
  lockerAvailable        Boolean   @default(false) @map("locker_available")
  shoeStandAvailable     Boolean   @default(false) @map("shoe_stand_available")
  drinkingWaterAvailable Boolean   @default(false) @map("drinking_water_available")
  toiletAvailable        Boolean   @default(false) @map("toilet_available")
  verified               Boolean   @default(false)
  featured               Boolean   @default(false)
  popular                Boolean   @default(false)
  viewCount              BigInt    @default(0) @map("view_count")
  favoriteCount          BigInt    @default(0) @map("favorite_count")
  shareCount             BigInt    @default(0) @map("share_count")
  ratingAverage          Decimal   @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount            BigInt    @default(0) @map("rating_count")
  searchKeywords         String?   @map("search_keywords") @db.Text
  searchPriority         Int       @default(0) @map("search_priority")
  isSearchable           Boolean   @default(true) @map("is_searchable")
  seoTitle               String?   @map("seo_title") @db.VarChar(255)
  seoDescription         String?   @map("seo_description") @db.Text
  metaKeywords           String?   @map("meta_keywords") @db.Text
  ogImage                String?   @map("og_image") @db.VarChar(500)
  schemaGenerated        Boolean   @default(false) @map("schema_generated")
  canonicalUrl           String?   @map("canonical_url") @db.Text
  publishedAt            DateTime? @map("published_at")
  status                 Status    @default(ACTIVE)
  sortOrder              Int       @default(0) @map("sort_order")
  createdBy              String?   @map("created_by") @db.Uuid
  updatedBy              String?   @map("updated_by") @db.Uuid
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  deletedAt              DateTime? @map("deleted_at")

  country               Country               @relation(fields: [countryId], references: [id], onDelete: Cascade)
  state                 State                 @relation(fields: [stateId], references: [id], onDelete: Cascade)
  city                  City                  @relation(fields: [cityId], references: [id], onDelete: Cascade)
  area                  Area                  @relation(fields: [areaId], references: [id], onDelete: Cascade)
  deityMaps             TempleDeityMap[]
  categories            TempleCategoryMap[]
  translations          TempleTranslation[]
  timings               TempleTiming[]
  aartis                TempleAarti[]
  poojas                TemplePooja[]
  darshanTypes          TempleDarshanType[]
  specialEvents         TempleSpecialEvent[]
  rules                 TempleRule[]
  facilities            TempleFacility[]
  contacts              TempleContact[]
  faqs                  TempleFaq[]
  accessibilityFeatures TempleAccessibility[]
  dressCodes            TempleDressCode[]
  pilgrimTips           TemplePilgrimTip[]
  routes                TempleRoute[]
  nearbyPlaces          TempleNearbyPlace[]
  parking               TempleParking[]
  accommodations        TempleAccommodation[]
  prasadam              TemplePrasadam[]
  media                 TempleMedia[]
  documents             TempleDocument[]
  sources               TempleSource[]
  liveDarshan           TempleLiveDarshan[]
  donations             TempleDonation[]
  externalLinks         TempleExternalLink[]
  qrCodes               TempleQrCode[]
  statistics            TempleStatistics?
  changeHistory         TempleChangeHistory[]
  festivalMaps          FestivalTempleMap[]

  @@index([countryId])
  @@index([stateId])
  @@index([cityId])
  @@index([areaId])
  @@index([featured])
  @@index([popular])
  @@index([verified])
  @@map("temples")
}

model TempleDeityMap {
  id        String   @id @default(uuid()) @db.Uuid
  templeId  String   @map("temple_id") @db.Uuid
  deityId   String   @map("deity_id") @db.Uuid
  isPrimary Boolean  @default(false) @map("is_primary")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  temple Temple @relation(fields: [templeId], references: [id], onDelete: Cascade)
  deity  Deity  @relation(fields: [deityId], references: [id], onDelete: Cascade)

  @@unique([templeId, deityId])
  @@index([templeId])
  @@index([deityId])
  @@map("temple_deity_map")
}

model TempleCategoryMap {
  id         String   @id @default(uuid()) @db.Uuid
  templeId   String   @map("temple_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  temple   Temple         @relation(fields: [templeId], references: [id], onDelete: Cascade)
  category TempleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

