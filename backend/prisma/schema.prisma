  sessions                UserSession[]
  refreshTokens           RefreshToken[]
  profile                 UserProfile?
  notificationPreferences UserNotificationPreference?
  favorites               UserFavorite[]
  reviews                 UserReview[]
  ratings                 UserRating[]
  comments                UserComment[]
  contentPublishLogs      ContentPublishLog[]
  deityChangeHistory      DeityChangeHistory[]
  panchangChangeHistory   PanchangChangeHistory[]

  @@index([email])
  @@index([mobile])
  @@index([role])
  @@index([status])
  @@index([deletedAt])
  @@map("users")
}

