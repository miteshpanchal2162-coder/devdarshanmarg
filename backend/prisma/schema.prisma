// ─── Module 7 Part 6: Astrology & Planetary Engine ────────────────────

model Planet {
  id          String    @id @default(uuid()) @db.Uuid
  planetCode  String    @unique @map("planet_code") @db.VarChar(50)
  name        String    @db.VarChar(150)
  slug        String    @unique @db.VarChar(255)
  description String?   @db.Text
  planetType  String?   @map("planet_type") @db.VarChar(100)
  status      Status    @default(ACTIVE)
  sortOrder   Int       @default(0) @map("sort_order")
  createdBy   String?   @map("created_by") @db.Uuid
  updatedBy   String?   @map("updated_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  planetPositions PanchangPlanetPosition[]
  rashiTransits   PanchangRashiTransit[]

  @@index([name])
  @@index([planetType])
  @@index([status])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("planets")
}

model Rashi {
  id           String    @id @default(uuid()) @db.Uuid
  rashiCode    String    @unique @map("rashi_code") @db.VarChar(50)
  name         String    @db.VarChar(150)
  slug         String    @unique @db.VarChar(255)
  symbol       String?   @db.VarChar(50)
  element      String?   @db.VarChar(50)
  rulingPlanet String?   @map("ruling_planet") @db.VarChar(100)
  description  String?   @db.Text
  status       Status    @default(ACTIVE)
  sortOrder    Int       @default(0) @map("sort_order")
  createdBy    String?   @map("created_by") @db.Uuid
  updatedBy    String?   @map("updated_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  planetPositions PanchangPlanetPosition[]
  transitsFrom    PanchangRashiTransit[]   @relation("RashiTransitFrom")
  transitsTo      PanchangRashiTransit[]   @relation("RashiTransitTo")

  @@index([name])
  @@index([element])
  @@index([status])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("rashis")
}

model PanchangPlanetPosition {
  id             String   @id @default(uuid()) @db.Uuid
  panchangDateId String   @map("panchang_date_id") @db.Uuid
  planetId       String   @map("planet_id") @db.Uuid
  rashiId        String   @map("rashi_id") @db.Uuid
  degree         Decimal? @db.Decimal(6, 2)
  longitude      Decimal? @db.Decimal(8, 4)
  isRetrograde   Boolean  @default(false) @map("is_retrograde")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  panchangDate PanchangDate @relation(fields: [panchangDateId], references: [id], onDelete: Cascade)
  planet       Planet       @relation(fields: [planetId], references: [id], onDelete: Restrict)
  rashi        Rashi        @relation(fields: [rashiId], references: [id], onDelete: Restrict)

  @@unique([panchangDateId, planetId])
  @@index([panchangDateId])
  @@index([planetId])
  @@index([rashiId])
  @@index([isRetrograde])
  @@map("panchang_planet_positions")
}

model PanchangRashiTransit {
  id             String   @id @default(uuid()) @db.Uuid
  panchangDateId String   @map("panchang_date_id") @db.Uuid
  planetId       String   @map("planet_id") @db.Uuid
  fromRashiId    String   @map("from_rashi_id") @db.Uuid
  toRashiId      String   @map("to_rashi_id") @db.Uuid
  transitTime    DateTime @map("transit_time")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  panchangDate PanchangDate @relation(fields: [panchangDateId], references: [id], onDelete: Cascade)
  planet       Planet       @relation(fields: [planetId], references: [id], onDelete: Restrict)
  fromRashi    Rashi        @relation("RashiTransitFrom", fields: [fromRashiId], references: [id], onDelete: Restrict)
  toRashi      Rashi        @relation("RashiTransitTo", fields: [toRashiId], references: [id], onDelete: Restrict)

  @@index([panchangDateId])
  @@index([planetId])
  @@index([fromRashiId])
  @@index([toRashiId])
  @@index([transitTime])
  @@map("panchang_rashi_transits")
}

