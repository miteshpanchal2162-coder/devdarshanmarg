# Test environment — copy to .env.test and set DATABASE_URL for e2e tests
NODE_ENV=test
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devdarshanmarg_test
JWT_ACCESS_SECRET=test-access-secret-minimum-32-characters
JWT_REFRESH_SECRET=test-refresh-secret-minimum-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
OTP_EXPIRES_IN=5m
OTP_MAX_RETRIES=5
OTP_VERIFICATION_TOKEN_EXPIRES_IN=10m
SWAGGER_ENABLED=false
LOG_LEVEL=error
UPLOAD_DIR=./test-uploads
