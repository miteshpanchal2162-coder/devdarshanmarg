# Server
PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=

# JWT
JWT_ACCESS_SECRET=change-this-access-secret-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# File Upload (local storage)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Swagger
SWAGGER_TITLE=DevDarshanMarg API
SWAGGER_DESCRIPTION=DevDarshanMarg backend API
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs

# Logging
LOG_LEVEL=info
