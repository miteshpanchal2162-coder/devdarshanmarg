# =============================================================================
# DevDarshanMarg API — Environment Variables
# Copy to .env and fill in values before running the backend.
# =============================================================================

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (PostgreSQL) ---
# Local Docker example:
# DATABASE_URL=postgresql://devdarshan:devdarshan123@localhost:5432/devdarshanmarg?schema=public
DATABASE_URL=

# --- JWT (minimum 32 characters each) ---
JWT_ACCESS_SECRET=change-this-access-secret-minimum-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-minimum-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# --- OTP ---
OTP_EXPIRES_IN=5m
OTP_MAX_RETRIES=5
OTP_VERIFICATION_TOKEN_EXPIRES_IN=10m

# --- File uploads (local storage) ---
# UPLOAD_DIR is preferred; UPLOAD_PATH is accepted as an alias.
# In production, at least one of UPLOAD_DIR or UPLOAD_PATH is required.
UPLOAD_DIR=./uploads

# --- CORS ---
# Comma-separated origins in production (required when NODE_ENV=production)
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# --- Swagger / OpenAPI ---
SWAGGER_TITLE=DevDarshanMarg API
SWAGGER_DESCRIPTION=DevDarshanMarg backend API
SWAGGER_VERSION=1.0.0
SWAGGER_PATH=docs
SWAGGER_ENABLED=true

# --- Logging ---
LOG_LEVEL=info
